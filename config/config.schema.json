{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WiFi-Looking configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": { "type": "number", "minimum": 1, "maximum": 60 }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "file": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "actions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": "string" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": {
              "oneOf": [
                { "enum": ["connected", "disconnected", "changed", "any"] },
                { "type": "array", "items": { "enum": ["connected", "disconnected", "changed", "any"] } }
              ]
            },
            "previousSsid": { "$ref": "#/$defs/ssidList" },
            "currentSsid": { "$ref": "#/$defs/ssidList" }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "cooldownSeconds": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "ssidList": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["log", "http", "clash.closeConnections", "command"] }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "log" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "http" },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "url": { "type": "string" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 100 }
          },
          "required": ["method", "url"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "clash.closeConnections" },
            "baseUrl": { "type": "string" },
            "secret": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 100 }
          },
          "required": ["baseUrl"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "command" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "timeoutMs": { "type": "integer", "minimum": 100 }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      ]
    }
  }
}
